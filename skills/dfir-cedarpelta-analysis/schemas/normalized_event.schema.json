{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cedarpelta Normalized Event",
  "type": "object",
  "required": ["event_id", "case_id", "host", "timestamp", "artifact_group", "artifact_type", "source_file", "event_type", "summary", "confidence"],
  "properties": {
    "event_id": {"type": "string"},
    "case_id": {"type": "string"},
    "host": {"type": "string"},
    "timestamp": {"type": "string"},
    "timestamp_timezone": {"type": "string"},
    "artifact_group": {"type": "string"},
    "artifact_type": {"type": "string"},
    "source_file": {"type": "string"},
    "event_type": {"type": "string"},
    "user": {"type": "string"},
    "process_name": {"type": "string"},
    "process_path": {"type": "string"},
    "command_line": {"type": "string"},
    "src_ip": {"type": "string"},
    "dst_ip": {"type": "string"},
    "dst_port": {"type": "string"},
    "file_path": {"type": "string"},
    "registry_key": {"type": "string"},
    "raw_event_id": {"type": "string"},
    "summary": {"type": "string"},
    "confidence": {"enum": ["low", "medium", "high"]}
  },
  "additionalProperties": true
}
